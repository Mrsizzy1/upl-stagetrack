# Copier ce fichier en .env puis remplacer chaque valeur marquée CHANGER.

NODE_ENV=development
PORT=3000

# Origine autorisée du frontend (CORS). Plusieurs valeurs : séparées par des virgules.
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# PostgreSQL (valeurs alignées sur docker-compose.yml)
DATABASE_URL=postgresql://stagetrack:stagetrack_dev@localhost:5432/stagetrack?schema=public
DATABASE_URL_TEST=postgresql://stagetrack:stagetrack_dev@localhost:5432/stagetrack_test?schema=public

# Fuseau de référence de l'UPL. Ne pas modifier sans décision de l'administration.
APP_TIMEZONE=Africa/Lubumbashi

# Secrets : au moins 32 caractères aléatoires chacun.
# Génération : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGER_secret_acces_32_caracteres_minimum
JWT_REFRESH_SECRET=CHANGER_secret_rafraichissement_32_caracteres_min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Clé AES-256 (32 octets en base64) pour chiffrer la copie des jetons QR.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QR_TOKEN_ENCRYPTION_KEY=CHANGER_cle_base64_de_32_octets

# Compte administrateur créé par le seed (mot de passe à changer à la première connexion).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGER_mot_de_passe_initial
SEED_ADMIN_FULLNAME=Administrateur StageTrack

# Exposer la documentation Swagger sur /api/docs
SWAGGER_ENABLED=true

# Dossier des photos d'étudiants (jamais servi directement par Nginx)
STORAGE_DIR=./storage

# Clôture automatique des sessions chaque minute (true en exploitation)
CLOSURE_JOB_ENABLED=true

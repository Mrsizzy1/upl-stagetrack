# Copier en deploy/.env.production (fichier exclu de Git) et remplacer chaque valeur CHANGER.

POSTGRES_USER=stagetrack
POSTGRES_PASSWORD=CHANGER_mot_de_passe_base_long_et_aleatoire
POSTGRES_DB=stagetrack

# Mots de passe distincts, générés en base64url (aucun caractère d'URL à encoder).
# Le processus API utilise uniquement APP_DB_PASSWORD.
APP_DB_PASSWORD=CHANGER_secret_application
MIGRATOR_DB_PASSWORD=CHANGER_secret_migration

# Adresse publique exacte de l'interface (ex. https://stagetrack.upl.local)
APP_BASE_URL=https://CHANGER.adresse.du.serveur
CORS_ORIGINS=https://CHANGER.adresse.du.serveur

APP_TIMEZONE=Africa/Lubumbashi

JWT_ACCESS_SECRET=CHANGER_secret_acces_32_caracteres_minimum
JWT_REFRESH_SECRET=CHANGER_secret_rafraichissement_32_caracteres_min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# À sauvegarder hors du serveur : sans cette clé, les QR existants ne peuvent plus être réaffichés
# (ils restent valides au scan, mais il faudrait les régénérer pour réimprimer les cartes).
QR_TOKEN_ENCRYPTION_KEY=CHANGER_cle_base64_de_32_octets

SWAGGER_ENABLED=false
CLOSURE_JOB_ENABLED=true

# Utilisés une seule fois par le seed initial, puis à retirer du fichier.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGER_mot_de_passe_initial
SEED_ADMIN_FULLNAME=Administrateur StageTrack
